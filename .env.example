# air-platform — every configuration key, with its default.
#
# Copy to `.env` (git-ignored) and edit. `make env` does the copy for you. Every key
# is read by pydantic-settings from the environment with the prefix AIR_PLATFORM__
# and `__` as the nesting delimiter, so anything here can equally be set by an
# orchestrator.
#
# Values shown are the defaults; lines that are commented out have no default (they
# are None) and setting them to an empty string is NOT the same thing. Complex types
# (lists, objects) are parsed as JSON.
#
# Keys marked [SECRET] must be injected at deploy time, never committed.

# ── Application ───────────────────────────────────────────────────────────────

# development | staging | production | test. `production` refuses the escape
# hatches below (SECURITY__ALLOW_UNAUTHENTICATED, SECURITY__LOG_RAW_TEXT).
AIR_PLATFORM__APP__ENV=development
# Bind address. Containers bind all interfaces by design.
AIR_PLATFORM__APP__HOST=0.0.0.0
# 8081 is this service's slot in the AIR port map (air-infra/README.md). 8080 is
# air-infra (store/secrets broker), 8082 air-classifier, 8083 air-llm (model
# gateway), 8084 air-tools, 8085 air-action, 8086 air-recommender, 8087 air-rag.
AIR_PLATFORM__APP__PORT=8081
AIR_PLATFORM__APP__WORKERS=2
# Mount path when served behind a gateway at a sub-path.
AIR_PLATFORM__APP__ROOT_PATH=
# /docs, /redoc and /openapi.json. Turn off for a public deployment.
AIR_PLATFORM__APP__DOCS_ENABLED=true
AIR_PLATFORM__APP__MAX_BODY_BYTES=1048576
AIR_PLATFORM__APP__SHUTDOWN_GRACE_SECONDS=15.0

# ── air-infra (required) ──────────────────────────────────────────────────────
#
# Brokers Redis/Postgres/Mongo credentials and secrets. Not the model path — that's
# air-llm, below. Reported on /v1/ready for operator visibility but does not gate
# it today; nothing in this service calls air-infra yet (Phase 2 work).
#
# Reached over HTTP rather than imported as a package — see clients/infra.py.

AIR_PLATFORM__INFRA__BASE_URL=http://localhost:8080
# [SECRET] air-infra service token, sent as X-API-Key. Blank locally only if
# air-infra runs with its own local default-allow policy.
#AIR_PLATFORM__INFRA__API_KEY=
AIR_PLATFORM__INFRA__TIMEOUT_S=30.0
# Deliberately much shorter than TIMEOUT_S: a readiness probe that waits as long as
# a real request detects an outage far too late to be useful.
AIR_PLATFORM__INFRA__HEALTH_TIMEOUT_S=2.0
AIR_PLATFORM__INFRA__MAX_RETRIES=2

# ── air-llm (required) ────────────────────────────────────────────────────────
#
# The one dependency without which no turn can be answered: the model gateway,
# reached directly and never via air-infra (air-llm was split out of air-infra's
# old gateway/ module). Owns the provider keys, cost accounting and the response
# cache. /v1/ready gates on this and on nothing else.
#
# Reached over HTTP rather than imported as a package — see clients/llm.py.

AIR_PLATFORM__LLM__BASE_URL=http://localhost:8083
# [SECRET] air-llm service token, sent as X-API-Key.
#AIR_PLATFORM__LLM__API_KEY=
AIR_PLATFORM__LLM__TIMEOUT_S=30.0
# Deliberately much shorter than TIMEOUT_S: a readiness probe that waits as long as
# a real request detects an outage far too late to be useful.
AIR_PLATFORM__LLM__HEALTH_TIMEOUT_S=2.0
AIR_PLATFORM__LLM__MAX_RETRIES=2
# Model/routing alias asked of air-llm. Unset takes air-llm's own default, which is
# the right choice locally where only Ollama is configured.
#AIR_PLATFORM__LLM__DEFAULT_MODEL=

# ── Downstream services (all optional) ────────────────────────────────────────
#
# Every one defaults to ENABLED=false, because air-rag, air-tools and air-action are
# currently empty repos. `enabled=false` and "unreachable" are the same fact from
# two sides: both remove the capability from /v1/capabilities and from the planner's
# inventory. Defaulting them on would make a fresh checkout report itself degraded
# against services that do not exist, which trains you to ignore the signal.

AIR_PLATFORM__DOWNSTREAM__CLASSIFIER__ENABLED=false
AIR_PLATFORM__DOWNSTREAM__CLASSIFIER__BASE_URL=http://localhost:8082
# air-classifier's .env.example ships this development key, valid only against that
# repo's development hash salt.
#AIR_PLATFORM__DOWNSTREAM__CLASSIFIER__API_KEY=airs_local_dev_key
AIR_PLATFORM__DOWNSTREAM__CLASSIFIER__TIMEOUT_MS=5000

AIR_PLATFORM__DOWNSTREAM__RAG__ENABLED=false
AIR_PLATFORM__DOWNSTREAM__RAG__BASE_URL=http://localhost:8087
#AIR_PLATFORM__DOWNSTREAM__RAG__API_KEY=
AIR_PLATFORM__DOWNSTREAM__RAG__TIMEOUT_MS=8000

AIR_PLATFORM__DOWNSTREAM__TOOLS__ENABLED=false
AIR_PLATFORM__DOWNSTREAM__TOOLS__BASE_URL=http://localhost:8084
#AIR_PLATFORM__DOWNSTREAM__TOOLS__API_KEY=
AIR_PLATFORM__DOWNSTREAM__TOOLS__TIMEOUT_MS=5000

# Mutations only, behind idempotency keys and approval gates. air-platform can never
# write directly — it proposes, and this service decides.
AIR_PLATFORM__DOWNSTREAM__ACTION__ENABLED=false
AIR_PLATFORM__DOWNSTREAM__ACTION__BASE_URL=http://localhost:8085
#AIR_PLATFORM__DOWNSTREAM__ACTION__API_KEY=
AIR_PLATFORM__DOWNSTREAM__ACTION__TIMEOUT_MS=10000

AIR_PLATFORM__DOWNSTREAM__RECOMMENDER__ENABLED=false
AIR_PLATFORM__DOWNSTREAM__RECOMMENDER__BASE_URL=http://localhost:8086
#AIR_PLATFORM__DOWNSTREAM__RECOMMENDER__API_KEY=
AIR_PLATFORM__DOWNSTREAM__RECOMMENDER__TIMEOUT_MS=5000

# ── Turn budget ───────────────────────────────────────────────────────────────
#
# Every value is a CEILING. A per-request `options` object may ask for less and never
# for more, so a caller cannot spend the operator's budget by asking nicely.

AIR_PLATFORM__TURN__DEADLINE_MS=15000
AIR_PLATFORM__TURN__MAX_COST_USD=0.25
AIR_PLATFORM__TURN__MAX_MODEL_CALLS=4
# Turns of history assembled into the prompt; older turns are summarised.
AIR_PLATFORM__TURN__WINDOW_TURNS=12

# ── Guardrails ────────────────────────────────────────────────────────────────
#
# Run inside the platform, on input and output both, because only the platform can
# see the assembled prompt — a gateway filter sees a request and cannot tell that a
# retrieved document is being read as an instruction.

AIR_PLATFORM__GUARDRAILS__CUSTOMER__INJECTION=true
AIR_PLATFORM__GUARDRAILS__CUSTOMER__REDACT_PII=true
AIR_PLATFORM__GUARDRAILS__CUSTOMER__GROUNDING=true
# Meaningless on the customer channel, which returns prose.
AIR_PLATFORM__GUARDRAILS__CUSTOMER__VALIDATE_SCHEMA=false

AIR_PLATFORM__GUARDRAILS__BUSINESS__INJECTION=true
# Configurable here, and only here: internal analysts legitimately query customer
# records. Configurable, never absent.
AIR_PLATFORM__GUARDRAILS__BUSINESS__REDACT_PII=true
AIR_PLATFORM__GUARDRAILS__BUSINESS__GROUNDING=true
AIR_PLATFORM__GUARDRAILS__BUSINESS__VALIDATE_SCHEMA=true

# ── Sessions ──────────────────────────────────────────────────────────────────
#
# memory | redis. `memory` is fine for a single-replica laptop run; anything
# autoscaled needs redis, or a conversation forgets itself whenever the load
# balancer moves. Redis is brokered by air-infra in a real deployment.

AIR_PLATFORM__SESSION__BACKEND=memory
AIR_PLATFORM__SESSION__REDIS_URL=redis://localhost:6379/1
AIR_PLATFORM__SESSION__KEY_PREFIX=air:plat:
AIR_PLATFORM__SESSION__TTL_SECONDS=86400
# How long a proposed mutation stays confirmable. Short on purpose: a stale "yes"
# must not be able to execute an hour-old proposal.
AIR_PLATFORM__SESSION__PROPOSAL_TTL_SECONDS=300

# ── Semantic cache ────────────────────────────────────────────────────────────
#
# Off until Phase 5. When it lands, only the direct-answer route is eligible —
# never a turn grounded in tool output, retrieval or per-user data. "Where is order
# 123" and "where is order 456" are near-identical vectors, and a permissive
# threshold turns a cost win into a wrong-answer incident.

AIR_PLATFORM__CACHE__ENABLED=false
AIR_PLATFORM__CACHE__BACKEND=memory
AIR_PLATFORM__CACHE__REDIS_URL=redis://localhost:6379/2
AIR_PLATFORM__CACHE__SIMILARITY_THRESHOLD=0.97
AIR_PLATFORM__CACHE__TTL_SECONDS=3600
AIR_PLATFORM__CACHE__MAX_ENTRIES=10000

# ── Prompts ───────────────────────────────────────────────────────────────────
#
# A prompt is production logic, so it is versioned and pinned rather than edited in
# place. JSON object of route name → pinned version.

#AIR_PLATFORM__PROMPTS__REGISTRY_PATH=prompts/
AIR_PLATFORM__PROMPTS__PINS={}

# ── Security ──────────────────────────────────────────────────────────────────
#
# A key record's `channel` is where the customer/business distinction is decided.
# It is a property of the credential, never of a request header — a client that
# could name its own channel could select the weaker guardrail profile.
#
# Records are a JSON array. `key_hash` is sha256(HASH_SALT + raw_key), hex. Mint one
# with:
#
#   python -c "from air_platform.security.api_keys import generate_key; \
#              print(generate_key('your-salt'))"
#
# The two keys below are valid only against the development salt, and a deployment
# overrides both halves. They are defaults rather than an auth bypass on purpose: a
# local run then exercises the same authenticated path as QA, so key-handling bugs
# surface on your laptop instead of in a shared environment.
#
#   airp_local_customer_key  → customer channel, POST /v1/chat
#   airp_local_business_key  → business channel, POST /v1/query
#
# Note neither grants allow_actions — mutations need a deliberately configured key.
AIR_PLATFORM__SECURITY__API_KEYS_INLINE=[{"id":"local-customer","name":"Local customer key","key_hash":"e5601c1d5139c751bcbd065da5a58c246af4498d9417a681a43ec25d4f23ac58","channel":"customer","tenant":"local","scopes":["chat:write","session:read","admin:read"],"allow_actions":false},{"id":"local-business","name":"Local business key","key_hash":"01c428c2b3478420dcc9b57f26b402ba80cbd86928f0b4ecbc4ee82676e1bf1a","channel":"business","tenant":"local","scopes":["query:write","session:read","admin:read"],"allow_actions":false}]
# Alternative to the inline form; inline wins when both are set, so an image can
# bake in a file and an environment variable can still override it.
#AIR_PLATFORM__SECURITY__API_KEYS_FILE=/etc/air-platform/keys.json
# Development escape hatch. Refused at startup when APP__ENV=production.
AIR_PLATFORM__SECURITY__ALLOW_UNAUTHENTICATED=false
# Channel granted to the anonymous identity when that hatch is open. `customer` is
# the stricter profile, so an unauthenticated developer gets tighter guardrails.
AIR_PLATFORM__SECURITY__ANONYMOUS_CHANNEL=customer
# [SECRET] Override in every real deployment; it is half of what makes a key valid.
AIR_PLATFORM__SECURITY__HASH_SALT=air-platform-dev-salt
AIR_PLATFORM__SECURITY__DEFAULT_RATE_LIMIT_RPM=120
AIR_PLATFORM__SECURITY__DEFAULT_BURST=20
# Deliberate opt-in, refused in production. When false, only a fingerprint and a
# length of user text is logged.
AIR_PLATFORM__SECURITY__LOG_RAW_TEXT=false

# ── Observability ─────────────────────────────────────────────────────────────

AIR_PLATFORM__OBS__SERVICE_NAME=air-platform
AIR_PLATFORM__OBS__LOG_LEVEL=INFO
# json | console. `console` is readable on a laptop; json is what a log shipper wants.
AIR_PLATFORM__OBS__LOG_FORMAT=json
AIR_PLATFORM__OBS__METRICS_ENABLED=true
AIR_PLATFORM__OBS__METRICS_PATH=/metrics
AIR_PLATFORM__OBS__OTEL_ENABLED=false
#AIR_PLATFORM__OBS__OTEL_ENDPOINT=http://localhost:4318
AIR_PLATFORM__OBS__OTEL_SAMPLE_RATIO=1.0
