{
  "about": "Message-to-plan cases for the planner prompt (spec 0013, REQ-PLN-009). Run with `make planner-eval` against air-model-gateway (live, paid, not in `make check`), before and after a planner prompt change. `menu` is the capabilities offered to every case unless a case names a subset. `expect` lists what must match: `reads` (names, in any order), `arguments` (per capability, each given key must equal), `propose` (a name or null) and `needs_results`. A key left out is not scored. `allow_any_reads` scores no reads. `round_two` gives the results a second round is shown and what it must propose.",
  "menu": [
    {
      "name": "orders.list_recent",
      "kind": "read",
      "version": 1,
      "requires_subject": true,
      "description": "The customer's most recent orders, newest first, with status and order number.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          }
        }
      }
    },
    {
      "name": "orders.get",
      "kind": "read",
      "version": 1,
      "requires_subject": true,
      "description": "One of the customer's orders by its order number: status, items, delivery estimate.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order_id"
        ],
        "properties": {
          "order_id": {
            "type": "string",
            "pattern": "^[0-9]{4,12}$"
          }
        }
      }
    },
    {
      "name": "orders.cancel",
      "kind": "write",
      "version": 1,
      "requires_subject": true,
      "risk": "low",
      "description": "Cancel one of the customer's orders that has not shipped yet, refunding the original payment method.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order_id"
        ],
        "properties": {
          "order_id": {
            "type": "string",
            "pattern": "^[0-9]{4,12}$"
          }
        }
      }
    }
  ],
  "cases": [
    {
